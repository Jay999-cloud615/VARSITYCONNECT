# ==========================================
# VarsityConnect Environment Configuration
# ==========================================
# Copy this file to .env and fill in your real credentials:
# (Note: .env is automatically ignored by Git for your security)

# Gmail SMTP Configuration
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password

# Optional Customizations (Defaults to Gmail 587 TLS)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=VarsityConnect <your_email@gmail.com>
